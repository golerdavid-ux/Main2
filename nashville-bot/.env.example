# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to the latest Opus.
ANTHROPIC_MODEL=claude-opus-4-8
# Thinking effort for the agent loop: low | medium | high | max
AGENT_EFFORT=medium

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The WhatsApp-enabled Twilio number (sandbox or your own), e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set to "true" in production to reject forged webhook requests.
VALIDATE_TWILIO_SIGNATURE=false
# Public URL Twilio uses to reach this server (needed for signature validation),
# e.g. https://abcd-1234.ngrok-free.app
PUBLIC_URL=

# --- App ---
PORT=3002
# Where the JSON trip state is persisted.
DATA_DIR=./data
# How the bot refers to itself, and the trip it is planning.
BOT_NAME=TripBot
TRIP_NAME=Nashville in September
# All participants who message the shared number are aggregated under this group
# key when Twilio does not provide a ConversationSid (classic Messaging API has
# no native group concept — see LEARNINGS.md).
DEFAULT_GROUP_ID=nashville-crew
# Trigger words that always wake the bot. Comma separated, case-insensitive.
# Outside of these, the agent itself decides whether a reply adds value.
WAKE_WORDS=tripbot,@tripbot,bot
